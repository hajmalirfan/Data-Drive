# development | production (production: HSTS, no API docs, strict secret checks)
ENVIRONMENT=development

# Security policy (see SECURITY.md)
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
MAX_REQUEST_BYTES=12582912

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret-key
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/agri
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=180
GEMINI_SPEECH_MODEL=gemini-flash-lite-latest
SEED_DEMO_DATA=false

# AI answer size (small = fast, farming-only answers)
AI_MAX_OUTPUT_TOKENS=200
AI_MAX_HISTORY_MESSAGES=6
AI_MAX_INPUT_CHARS=1200

# Local Ollama provider (install from https://ollama.com, then: ollama pull llama3.2:3b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
TRANSPORT_RATE_PER_KM=28
LOADING_COST=500
MARKET_LOSS_PCT=2
LABOUR_COST_PER_KG=0.4
COMMISSION_PCT=2
PACKAGING_COST_PER_KG=0.25
STALE_PRICE_HOURS=48

# Password reset OTP
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRE_MINUTES=15

# Default admin (created on startup if missing; sign-in requires an emailed OTP)
ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin

# Mailtrap Email Sending API (used first for OTP delivery)
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_FROM_EMAIL=SmartAgopsAdvisor@demomailtrap.co
MAILTRAP_FROM_NAME=SmartAg Ops Advisor

# Optional SMTP fallback when no Mailtrap token is set.
# Leave SMTP_HOST empty to log the OTP to the backend console (local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
